# PocketBase backend URL (e.g. http://127.0.0.1:8090 or https://pocketbase.yourdomain.com)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Python backend API URL for bank statements (e.g. http://127.0.0.1:5000/statements or https://api.yourdomain.com/statements)
VITE_API_URL=http://127.0.0.1:5000/statements

# Comma-separated list of allowed user emails
VITE_ALLOWED_EMAILS=user@example.com

# Whether new user registration is permitted (true/false)
VITE_ALLOW_PUBLIC_REGISTRATION=false
